      "targets": [
        {
          "dataset": "iiot_gateway",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  sub.day AS \"time\",\r\n  ROUND( (SUM(sub.kwh_used) * 0.12)::numeric, 4 ) AS \"Total Cost (€)\"\r\nFROM (\r\n  SELECT\r\n    DATE_TRUNC('day', d.timestamputc) AS day,\r\n    d.sourceid,\r\n    MAX(d.value) - MIN(d.value) AS kwh_used\r\n  FROM datalog2 d\r\n  INNER JOIN sources s ON d.sourceid = s.sourceid\r\n  INNER JOIN quantities q ON d.quantityid = q.quantityid\r\n  WHERE\r\n    q.quantityname = 'Active_Energy_Delivered'\r\n    AND d.timestamputc BETWEEN $__timeFrom() AND $__timeTo()\r\n    AND s.devicename IN (\r\n      'Supply Fan',\r\n      'Exhaust Fan',\r\n      'Heat Recovery Motor',\r\n      'Pump',\r\n      'Heating Valve'\r\n    )\r\n  GROUP BY\r\n    DATE_TRUNC('day', d.timestamputc),\r\n    d.sourceid\r\n) AS sub\r\nGROUP BY sub.day\r\nORDER BY \"time\" ASC;\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Daily consumption in currency",
      "type": "timeseries"
