        {
          "dataset": "iiot_gateway",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  timestamp AS \"time\",\r\n  MAX(CASE WHEN field_name = 'Sim_SupplyTemp_GT71_01' THEN field_value END) AS \"Supply Temp GT71_01\",\r\n  MAX(CASE WHEN field_name = 'Sim_ExhaustTemp_GT72_01' THEN field_value END) AS \"Exhaust Temp GT72_01\",\r\n  MAX(CASE WHEN field_name = 'Sim_ReturnTemp_GT81_01' THEN field_value END) AS \"Return Temp GT81_01\"\r\nFROM sensor_data\r\nWHERE\r\n  $__timeFilter(timestamp)\r\n  AND field_name IN (\r\n    'Sim_SupplyTemp_GT71_01',\r\n    'Sim_ExhaustTemp_GT72_01',\r\n    'Sim_ReturnTemp_GT81_01'\r\n  )\r\nGROUP BY timestamp\r\nORDER BY timestamp ASC\r\n\r\n\r\n\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
