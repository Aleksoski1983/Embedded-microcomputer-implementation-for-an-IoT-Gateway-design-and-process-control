      "targets": [
        {
          "dataset": "iiot_gateway",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n    date_trunc('hour', d.timestamputc) AS hour,\r\n    s.devicename,\r\n    MAX(d.value) - MIN(d.value) AS energy_consumed,\r\n    q.unit\r\nFROM datalog2 d\r\nJOIN sources s ON d.sourceid = s.sourceid\r\nJOIN quantities q ON d.quantityid = q.quantityid\r\nWHERE q.quantityname = 'Active_Energy_Delivered'\r\n  AND s.devicename IN (\r\n      'Supply Fan',\r\n      'Exhaust Fan',\r\n      'Heat Reovery Pump',\r\n      'Pump',\r\n      'Heating Valve'\r\n  )\r\nGROUP BY\r\n    hour,\r\n    s.devicename,\r\n    q.unit\r\nORDER BY\r\n    hour DESC,\r\n    s.devicename;",
          "refId": "A",
          "sql": {
            "columns": [
