          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n    s.devicename AS \"Device\",\r\n    d.value      AS \"Power Factor\",\r\n    d.timestamputc AS \"Timestamp\"\r\nFROM datalog2 d\r\nJOIN sources s    ON d.sourceid   = s.sourceid\r\nJOIN quantities q ON d.quantityid = q.quantityid\r\nWHERE\r\n    q.quantityname = 'Power_Factor_Total'\r\n    AND d.timestamputc = (\r\n        SELECT MAX(d2.timestamputc)\r\n        FROM datalog2 d2\r\n        WHERE d2.sourceid = d.sourceid\r\n          AND d2.quantityid = d.quantityid\r\n    )\r\nORDER BY s.devicename;",
