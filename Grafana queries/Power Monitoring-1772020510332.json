        {
          "dataset": "iiot_gateway",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n    SUM(latest.value) AS total_active_energy,\r\n    MAX(latest.unit) AS unit\r\nFROM (\r\n    SELECT DISTINCT ON (s.devicename)\r\n        s.devicename,\r\n        d.value,\r\n        q.unit\r\n    FROM datalog2 d\r\n    JOIN sources s ON d.sourceid = s.sourceid\r\n    JOIN quantities q ON d.quantityid = q.quantityid\r\n    WHERE q.quantityname = 'Active_Energy_Delivered'\r\n      AND s.devicename IN (\r\n         'Supply Fan',\r\n         'Exhaust Fan',\r\n         'Heat Recovery Motor',\r\n         'Pump',\r\n         'Heating Valve'\r\n      )\r\n    ORDER BY s.devicename, d.timestamputc DESC\r\n) latest;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Total Active Energy Delivered",
      "type": "stat"
