        {
          "dataset": "iiot_gateway",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\r\nSELECT\r\n    $__timeGroup(d.timestamputc, $__interval) AS \"time\",\r\n    s.devicename                              AS \"Consumer\",\r\n\r\n    -- Peak values per bucket (max)\r\n    ROUND(MAX(CASE WHEN q.quantityname = 'Peak_Active_Demand' THEN d.value END)::numeric, 3) AS \"Peak Active Demand\",\r\n    ROUND(MAX(CASE WHEN q.quantityname = 'Peak_Reactive_Demand' THEN d.value END)::numeric, 3) AS \"Peak Reactive Demand\"\r\n\r\nFROM datalog2 d\r\nJOIN sources s    ON d.sourceid   = s.sourceid\r\nJOIN quantities q ON d.quantityid = q.quantityid\r\nWHERE\r\n    q.quantityname IN ('Peak_Active_Demand', 'Peak_Reactive_Demand')\r\n    AND $__timeFilter(d.timestamputc)\r\n\r\n    -- Optional Grafana device filter:\r\n    -- AND (${consumer:csv} OR s.devicename IN ('Supply Fan','Exhaust Fan','Heat Recovery Motor','Pump','Heating Valve'))\r\n\r\nGROUP BY 1, 2\r\nORDER BY 1, 2;\r\n\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
