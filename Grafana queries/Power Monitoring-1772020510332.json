          "dataset": "iiot_gateway",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\r\nSELECT\r\n  $__timeGroup(d.timestamputc, $__interval) AS \"time\",\r\n  s.devicename                              AS \"Consumer\",\r\n  ROUND(AVG(CASE WHEN q.quantityname = 'Current_A' THEN d.value END)::numeric, 3) AS \"Phase A Current (A)\",\r\n  ROUND(AVG(CASE WHEN q.quantityname = 'Current_B' THEN d.value END)::numeric, 3) AS \"Phase B Current (A)\",\r\n  ROUND(AVG(CASE WHEN q.quantityname = 'Current_C' THEN d.value END)::numeric, 3) AS \"Phase C Current (A)\",\r\n  ROUND(AVG(CASE WHEN q.quantityname = 'Current_N' THEN d.value END)::numeric, 3) AS \"Neutral Current (A)\"\r\nFROM datalog2 d\r\nJOIN sources s    ON d.sourceid   = s.sourceid\r\nJOIN quantities q ON d.quantityid = q.quantityid\r\nWHERE\r\n  q.quantityname IN ('Current_A','Current_B','Current_C','Current_N')\r\n  AND $__timeFilter(d.timestamputc)\r\nGROUP BY 1, 2\r\nORDER BY 1, 2;\r\n\r\n",
          "refId": "A",
